{
  "name": "sintesi",
  "version": "0.1.0",
  "description": "SINTESI \u2014 Un ritratto di ci\u00f2 che rimane. Generative audiovisual work, Martin Minotti, 2026.",
  "private": true,
  "type": "module",
  "author": "Martin Minotti",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "exhibit": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "render": "tsx scripts/render.ts",
    "render:dev": "tsx scripts/render.ts --quality=dev",
    "render:preview": "tsx scripts/render.ts --quality=preview",
    "render:final": "tsx scripts/render.ts --quality=final",
    "export": "tsx scripts/export.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "check": "tsc --noEmit && vitest run && tsx scripts/validate.ts --static"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "playwright": "1.56.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
